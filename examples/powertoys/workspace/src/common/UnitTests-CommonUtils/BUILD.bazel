load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//bazel:rc.bzl", "windows_resources")
load("//bazel:vstest.bzl", "vstest_test")

# UnitTests-CommonUtils.vcxproj (Release|x64), from msbuild.report.json.
# ConfigurationType DynamicLibrary, TargetName Common.Utils.UnitTests: a
# CppUnitTest DLL, loaded by vstest.console.exe.
cc_binary(
    name = "Common.Utils.UnitTests.dll",
    testonly = True,
    srcs = glob(["*.h"]) + [
        "AppMutex.Tests.cpp",
        "ColorUtils.Tests.cpp",
        "ComObjectFactory.Tests.cpp",
        "ContextMenuLifecycle.Tests.cpp",
        "Elevation.Tests.cpp",
        "ExcludedApps.Tests.cpp",
        "Exec.Tests.cpp",
        "GameMode.Tests.cpp",
        "Gpo.Tests.cpp",
        "HDropIterator.Tests.cpp",
        "HttpClient.Tests.cpp",
        "Json.Tests.cpp",
        "LoggerHelper.Tests.cpp",
        "ModulesRegistry.Tests.cpp",
        "MsiUtils.Tests.cpp",
        "MsWindowsSettings.Tests.cpp",
        "OsDetect.Tests.cpp",
        "Package.Tests.cpp",
        "pch.cpp",
        "PipeCallerAuth.Tests.cpp",
        "ProcessApi.Tests.cpp",
        "ProcessPath.Tests.cpp",
        "ProcessWaiter.Tests.cpp",
        "Registry.Tests.cpp",
        "Resources.Tests.cpp",
        "Serialized.Tests.cpp",
        "StringUtils.Tests.cpp",
        "TestStubs.cpp",
        "Threading.Tests.cpp",
        "TimeUtils.Tests.cpp",
        "TwoWayPipeMessageIPC.Tests.cpp",
        "UnhandledException.Tests.cpp",
        "WinApiError.Tests.cpp",
        "Window.Tests.cpp",
        "//src/common:interop/pipe_caller_auth.cpp",
        "//src/common:interop/two_way_pipe_message_ipc.cpp",
    ],
    copts = [
        "/Isrc/common",
        "/Isrc/common/utils",
        "/Isrc/common/Telemetry",
        "/Isrc",
        "/Ideps",
        "/W4",
        "/WX",
        "/permissive",
        "/sdl",
        "/utf-8",
        "/wd4679",
        "/wd4706",
        "/wd4874",
        "/wd5271",
        "/external:W0",
        "/external:anglebrackets",
    ],
    cxxopts = ["/std:c++23preview"],
    # The reference build uses the static C runtime (/MT). The feature also
    # swaps the default library, which a bare `/MT` in copts would not.
    features = ["static_link_msvcrt"],
    linkopts = [
        "/SUBSYSTEM:WINDOWS",
        "/MANIFEST:EMBED",
        "/guard:cf",
        "runtimeobject.lib",
        "msi.lib",
        "shlwapi.lib",
        "kernel32.lib",
        "user32.lib",
        "gdi32.lib",
        "winspool.lib",
        "comdlg32.lib",
        "advapi32.lib",
        "shell32.lib",
        "ole32.lib",
        "oleaut32.lib",
        "uuid.lib",
        "odbc32.lib",
        "odbccp32.lib",
        "windowsapp.lib",
    ],
    linkshared = True,
    local_defines = [
        "CODE_ANALYSIS",
        "SPDLOG_HEADER_ONLY",
        "SPDLOG_WCHAR_TO_UTF8_SUPPORT",
        "TWO_WAY_PIPE_MESSAGE_IPC_TESTS",
        "UNICODE",
        "_SILENCE_EXPERIMENTAL_COROUTINE_DEPRECATION_WARNINGS",
        "_SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING",
        "_UNICODE",
        "_WINDLL",
    ],
    deps = [
        ":version_info",
        "//:winrt_platform",
        "//src/common:headers",
        "//src/modules/Workspaces/WorkspacesLib:ipc_helper_hdrs",
        "@msvc//:cppunittest",
        "@nuget_wil//:wil",
        "@vcpkg//:spdlog",
    ],
)

windows_resources(
    name = "version_info",
    testonly = True,
    src = "UnitTests-CommonUtils.rc",
    hdrs = ["resource.h"],
    defines = [
        "_UNICODE",
        "UNICODE",
    ],
    opts = ["/l0x0409"],
    rc = "@windows_sdk//:bin/x64/rc.exe",
    deps = ["//src/common/version:headers"],
)

vstest_test(
    name = "unit_tests",
    dll = ":Common.Utils.UnitTests.dll",
)
