"""NuGet packages for rules_dotnet, from a lock that records what MSBuild resolved.

`scripts/nuget_assets.py` (any2bazel) writes `nuget_lock.json` from the
reference build: for every package, its integrity and, per target framework,
exactly the files the build used -- the reference assemblies each compile was
given, the analyzers, the run-time assemblies. This rule downloads each package
by integrity and exposes that selection:

    @<name>//<package id>/<version>:<framework>      an import_library
    @<name>//<package id>/<version>:<framework>.refs       its reference assemblies, as files
    @<name>//<package id>/<version>:<framework>.analyzers  its analyzers, as files
    @<name>//<package id>/<version>:<path in package>  any other file the build named
    @<name>//<package id>/<version>:cc.headers        its include directories, for C++ targets
    @<name>//<package id>/<version>:cc.<file>.lib     one library it links

The two file groups are for `csc_assembly.bzl`, which is given references as
files. A framework pack the reference build read from the machine
(WindowsDesktop, ASP.NET, the .NET Framework reference assemblies) is in the
lock as the package it is a copy of, and is a dependency like any other.

Nothing is resolved here. rules_dotnet's own `nuget_repo` re-derives the asset
selection from the package layout and does not know platform target frameworks
(`net8.0-windows10.0.19041.0`), so it silently drops what is filed under them;
a lock of MSBuild's answer has no such gap and cannot disagree with the
reference.

Feeds are the ones the reference build restored from (recorded in the lock).
Each is asked for its PackageBaseAddress; a package is taken from the first
feed that has it and must match the recorded SHA-512.
"""

def _base_addresses(rctx, sources):
    bases = []
    for i, source in enumerate(sources):
        index = "feeds/index_%d.json" % i
        result = rctx.download(url = source, output = index, allow_fail = True)
        if not result.success:
            continue
        for resource in json.decode(rctx.read(index)).get("resources", []):
            if resource.get("@type", "").startswith("PackageBaseAddress"):
                bases.append(resource["@id"].rstrip("/"))
    return bases

def _label_list(items):
    return "[%s]" % ", ".join(['"%s"' % i for i in items])

def _nuget_assets_impl(rctx):
    lock = json.decode(rctx.read(rctx.attr.lock))
    if lock.get("schema") != 1:
        fail("unsupported nuget lock schema: %s" % lock.get("schema"))
    bases = _base_addresses(rctx, lock["sources"] + rctx.attr.extra_sources)
    if not bases:
        fail("no NuGet feed in the lock could be reached: %s" % ", ".join(lock["sources"]))

    # Download everything at once, then unpack.
    pending = []
    for key, package in lock["packages"].items():
        if not package["integrity"]:
            fail("package %s has no integrity in the lock" % key)
        file_name = "%s.%s.nupkg" % (package["id"].lower(), package["version"].lower())
        archive = "_nupkg/%s.zip" % key.replace("/", ".")
        pending.append((key, archive, rctx.download(
            url = ["%s/%s/%s" % (base, key, file_name) for base in bases],
            output = archive,
            integrity = package["integrity"],
            block = False,
        )))
    for key, archive, download in pending:
        download.wait()
        rctx.extract(archive, output = key)
        rctx.delete(archive)

    # Files some compile names directly (a source or a config shipped in a package).
    loose = {}

    # Files MSBuild copied beside a program: addressable, and nothing else.
    deployed = {}
    for target in lock["targets"].values():
        for key, files in target["files"].items():
            for f in files:
                loose.setdefault(key, {})[f] = True
        for key, files in target.get("deployed", {}).items():
            for f in files:
                deployed.setdefault(key, {})[f] = True

    for key, package in lock["packages"].items():
        exported = dict(loose.get(key, {}))
        exported.update(deployed.get(key, {}))
        build = [
            "# Generated by nuget_assets.bzl from the lock: %s %s" % (package["id"], package["version"]),
            'load("@rules_dotnet//dotnet:defs.bzl", "import_library")',
            "",
            'package(default_visibility = ["//visibility:public"])',
            "",
        ]
        for framework, chosen in package["frameworks"].items():
            for files in chosen.values():
                for f in files:
                    exported[f] = True

            # A reference that takes the place of an assembly of the toolchain's
            # own pack (WindowsDesktop's WindowsBase.dll, where the base pack
            # has a facade of that name). rules_dotnet drops its copy only for
            # a direct dependency NAMED like the assembly and newer than it,
            # so each such file is a target of its own.
            overrides = chosen.get("overrides", [])
            for f in overrides:
                assembly = f.split("/")[-1].rsplit(".", 1)[0]
                build += [
                    "import_library(",
                    '    name = "%s.as.%s",' % (framework, assembly),
                    '    library_name = "%s",' % assembly,
                    '    version = "99999.0.0",',
                    '    refs = ["%s"],' % f,
                    ")",
                    "",
                ]

            # rules_dotnet keys what a program loads by library name and
            # version: two selections of one package under one name would
            # overwrite each other, and a program could lose its assemblies to
            # a library's compile-only selection.
            library_name = package["id"] if len(package["frameworks"]) == 1 else "%s (%s)" % (package["id"], framework)
            build += [
                "import_library(",
                '    name = "%s",' % framework,
                '    library_name = "%s",' % library_name,
                '    version = "%s",' % package["version"],
                "    refs = %s," % _label_list([f for f in chosen.get("compile", []) if f not in overrides]),
                "    libs = %s," % _label_list(chosen.get("runtime", [])),
                "    native = %s," % _label_list(chosen.get("native", [])),
                "    resource_assemblies = %s," % _label_list(chosen.get("resources", [])),
                "    analyzers = %s," % _label_list(chosen.get("analyzers", [])),
                ")",
                "",
                'filegroup(name = "%s.refs", srcs = %s)' % (framework, _label_list(chosen.get("compile", []))),
                'filegroup(name = "%s.analyzers", srcs = %s)' % (framework, _label_list(chosen.get("analyzers", []))),
                "",
            ]

        # What C++ targets take from the package: its include directories as one
        # header-only library, each library it links as a target of its own.
        cc = package.get("cc", {})
        if cc:
            build.insert(2, 'load("@rules_cc//cc:defs.bzl", "cc_library")')
            dirs = cc.get("include_dirs", [])
            build += [
                "cc_library(",
                '    name = "cc.headers",',
                "    hdrs = glob(%s, allow_empty = True)," % _label_list([d + "/**" for d in dirs]),
                "    includes = %s," % _label_list(dirs),
                ")",
                "",
            ]
            for lib in cc.get("libs", []):
                build += ['cc_library(name = "cc.%s", srcs = ["%s"])' % (lib.split("/")[-1], lib), ""]
        build.append("exports_files(%s)" % _label_list(sorted(exported.keys())))
        build += [
            "",
            "# Every file of the package the build names directly, for rules that",
            "# take a set of them (sources a package embeds into its consumers).",
            "filegroup(",
            '    name = "files",',
            "    srcs = %s," % _label_list(sorted(loose.get(key, {}).keys())),
            ")",
        ]
        rctx.file(key + "/BUILD.bazel", "\n".join(build) + "\n")
    rctx.file("BUILD.bazel", "# Packages are at //<id>/<version>.\n")

nuget_assets = repository_rule(
    implementation = _nuget_assets_impl,
    attrs = {
        "lock": attr.label(mandatory = True, allow_single_file = True, doc = "nuget_lock.json written by nuget_assets.py."),
        "extra_sources": attr.string_list(doc = "Further NuGet v3 index URLs to try, after the ones in the lock."),
    },
    doc = "Downloads the packages of a NuGet lock by integrity and exposes MSBuild's asset selection.",
)
