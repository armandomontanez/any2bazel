"""A vcpkg manifest install owned by Bazel.

MSBuild's vcpkg integration runs `vcpkg install` from inside the build, into a
`vcpkg_installed` directory in the source tree, and then offers every installed
library to every link. This rule runs the SAME recipe -- the project's own
manifest, baseline, overlay triplets and overlay ports, unmodified -- into a
Bazel repository instead, so the Bazel build does not read MSBuild's tree, and
generates one target per port so each binary declares what it uses.

It deliberately does not substitute another source for the libraries (a
registry module, a NuGet package of the same name): different versions, patches
and build flags would make any comparison with the reference build meaningless.

Limits, stated plainly:
  * vcpkg itself comes from the machine (VCPKG_ROOT, as Visual Studio sets it),
    and builds with whatever compiler it finds. Pin both if that matters.
  * A cold install downloads and compiles the ports inside a repository rule:
    slow, unsandboxed, not remotely cacheable. vcpkg's binary cache makes
    repeat runs fast. Moving the build into an action with Bazel-fetched
    sources is the next step (see any2bazel's Ladybird case study).
"""

def _run(rctx, argv, what, timeout = 3600, working_directory = ""):
    result = rctx.execute(argv, timeout = timeout, working_directory = working_directory, quiet = False)
    if result.return_code != 0:
        fail("%s failed (exit %d):\n%s\n%s" % (what, result.return_code, result.stdout[-4000:], result.stderr[-4000:]))
    return result

def _copy_tree(rctx, src, dst):
    # robocopy: exit codes below 8 mean success.
    result = rctx.execute(["robocopy", str(src).replace("/", "\\"), str(dst).replace("/", "\\"), "/E", "/NFL", "/NDL", "/NJH", "/NJS", "/NP"])
    if result.return_code >= 8:
        fail("copying %s failed:\n%s" % (src, result.stdout))

def _port_name(list_file, triplet):
    # <port>_<version>_<triplet>.list ; port names contain no underscore.
    stem = list_file[:-len(".list")]
    if not stem.endswith("_" + triplet):
        return None
    return stem.split("_", 1)[0]

def _vcpkg_install_impl(rctx):
    triplet = rctx.attr.triplet
    vcpkg_root = (rctx.attr.vcpkg_root or rctx.getenv("VCPKG_ROOT") or "").replace("\\", "/").rstrip("/")
    if not vcpkg_root or not rctx.path(vcpkg_root + "/vcpkg.exe").exists:
        fail("vcpkg not found: set VCPKG_ROOT (Visual Studio's is <VS>/VC/vcpkg) or the vcpkg_root attribute")

    # Copy the recipe so that nothing is written into the source tree.
    manifest = rctx.path(rctx.attr.manifest)
    source_dir = manifest.dirname
    rctx.file("recipe/vcpkg.json", rctx.read(manifest))
    for name in ("vcpkg-configuration.json",):
        extra = source_dir.get_child(name)
        if extra.exists:
            rctx.file("recipe/" + name, rctx.read(extra))
    for d in rctx.attr.recipe_dirs:
        src = rctx.path("%s/%s" % (source_dir, d))
        _copy_tree(rctx, src, rctx.path("recipe/" + d))
        rctx.watch_tree(src)

    recipe = str(rctx.path("recipe"))
    if rctx.attr.prepare:
        _run(rctx, rctx.attr.prepare, "vcpkg recipe preparation", working_directory = recipe)

    installed = str(rctx.path("installed"))
    _run(rctx, [
        vcpkg_root + "/vcpkg.exe",
        "install",
        "--triplet",
        triplet,
        "--vcpkg-root",
        vcpkg_root,
        "--x-manifest-root=" + recipe,
        "--x-install-root=" + installed,
    ] + rctx.attr.install_options, "vcpkg install")

    # One target per port, from vcpkg's own record of what each port installed.
    info = rctx.path("installed/vcpkg/info")
    build = [
        "# Generated by //bazel:vcpkg.bzl from installed/vcpkg/info/*.list",
        'load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")',
        "",
        'package(default_visibility = ["//visibility:public"])',
        "",
        "# The install tree's include directory without any port's headers: for a",
        "# target whose command line names the directory and whose sources include",
        "# nothing from it (vcpkg's MSBuild integration adds it to every project).",
        'cc_library(name = "include", includes = ["installed/%s/include"])' % triplet,
        "",
    ]
    ports = []
    for entry in sorted(info.readdir(), key = lambda p: p.basename):
        port = _port_name(entry.basename, triplet)
        if not port:
            continue  # host tools installed under another triplet
        headers, libs = [], []
        for line in rctx.read(entry).splitlines():
            path = line.strip()
            if not path or path.endswith("/"):
                continue
            if path.startswith(triplet + "/include/"):
                headers.append("installed/" + path)
            elif path.startswith(triplet + "/lib/") and path.endswith(".lib") and path.count("/") == 2:
                libs.append("installed/" + path)
        ports.append(port)
        imports = []
        for lib in libs:
            name = "%s__%s" % (port, lib.rsplit("/", 1)[1][:-len(".lib")])
            imports.append(":" + name)
            build.append('cc_import(name = "%s", static_library = "%s", visibility = ["//visibility:private"])' % (name, lib))
        build.append("cc_library(")
        build.append('    name = "%s",' % port)
        build.append("    hdrs = %s," % repr(headers))
        build.append('    includes = ["installed/%s/include"],' % triplet)
        build.append("    deps = %s," % repr(imports))
        build.append(")")
        build.append("")
    build.append("# Ports installed for %s: %s" % (triplet, ", ".join(ports)))
    rctx.file("BUILD.bazel", "\n".join(build) + "\n")

vcpkg_install = repository_rule(
    implementation = _vcpkg_install_impl,
    attrs = {
        "manifest": attr.label(mandatory = True, allow_single_file = True, doc = "The project's vcpkg.json."),
        "triplet": attr.string(mandatory = True, doc = "The triplet the reference build used (report: externals -> vcpkg)."),
        "recipe_dirs": attr.string_list(doc = "Directories beside the manifest that it refers to: overlay triplets, overlay ports."),
        "prepare": attr.string_list(doc = "Command run in the copied recipe directory before installing."),
        "install_options": attr.string_list(doc = "Extra `vcpkg install` arguments."),
        "vcpkg_root": attr.string(doc = "vcpkg to use; defaults to VCPKG_ROOT."),
    },
    environ = ["VCPKG_ROOT"],
    doc = "Runs the project's vcpkg manifest into a repository and exposes one cc_library per port.",
)
