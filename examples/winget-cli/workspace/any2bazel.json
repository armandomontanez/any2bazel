  "ignore": {
    "include_map": [
      {
        "from": "external/+http_archive+nuget_wil",
        "to": "@nuget/microsoft.windows.implementationlibrary"
      },
      {
        "from": "bazel-out/x64_windows-opt/bin/external/+http_archive+nuget_wil",
        "to": "@nuget/microsoft.windows.implementationlibrary"
      },
      {
        "from": "external/+vcpkg_install+vcpkg/installed",
        "to": "@vcpkg"
      },
      {
        "from": "bazel-out/x64_windows-opt/bin/external/+vcpkg_install+vcpkg/installed",
        "to": "@vcpkg"
      },
      {
        "from": "src/AppInstallerSharedLib/x64/Release/Generated Files",
        "to": "@winrt-projection"
      },
      {
        "from": "bazel-out/x64_windows-opt/bin/winrt_platform",
        "to": "@winrt-projection"
      }
    ],
    "source_map": [
      {
        "from": "src/WinGetServer/WinGetServer_c.c",
        "to": "@midl/WinGetServer_c.c"
      },
      {
        "from": "bazel-out/x64_windows-opt/bin/src/WinGetServer/WinGetServer_c.c",
        "to": "@midl/WinGetServer_c.c"
      }
    ]
  },
  "target_map": {
    "UndockedRegFreeWinRT": "src/Xlang/UndockedRegFreeWinRT/src/UndockedRegFreeWinRT/UndockedRegFreeWinRT:winrtact.dll"
  }
}