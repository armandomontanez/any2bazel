"""Optional parts of the pinned Visual Studio instance, as a Bazel repository.

The C++ toolchain already provides the compiler, the linker, and the default
include and library directories. MSBuild reaches further into the Visual Studio
installation than that, and nothing on a compile line says so:

  <SpectreMitigation>Spectre</SpectreMitigation>
      puts `<toolset>\\lib\\spectre\\<arch>` ahead of `<toolset>\\lib\\<arch>`, so
      the link picks up the Spectre-mitigated C runtime and STL. (`/Qspectre`
      on the compile line only covers the project's own code.)

  the C++ unit-test framework (`CppUnitTest.h`)
      lives in `VC\\Auxiliary\\VS\\UnitTest`, which MSBuild adds to every
      project's include and library path. Its header names its library with
      `#pragma comment(lib, "<arch>\\...")`, so only a search path is needed.

  vstest.console.exe
      what actually runs a CppUnitTest DLL. MSBuild does not run tests at all;
      CI calls this.

This rule exposes those BY LABEL, from the same instance and toolset the
toolchain is pinned to (BAZEL_VC / BAZEL_VC_FULL_VERSION), and fails if a
component is missing instead of silently building something else.

  @<name>//:spectre_libs   add to `deps` of every binary whose reference link
                           has `/LIBPATH:...\\lib\\spectre\\<arch>`
  @<name>//:cppunittest    add to `deps` of a CppUnitTest DLL
  @<name>//:defs.bzl       VSTEST_CONSOLE, for a test rule (see vstest.bzl)
"""

def _msvc_toolset_impl(rctx):
    vc = (rctx.attr.vc or rctx.getenv("BAZEL_VC") or "").replace("\\", "/").rstrip("/")
    version = rctx.attr.version or rctx.getenv("BAZEL_VC_FULL_VERSION") or ""
    if not vc or not version:
        fail("set the vc and version attributes, or BAZEL_VC and BAZEL_VC_FULL_VERSION " +
             "(with --repo_env, the same values that pin the C++ toolchain)")
    root = "%s/Tools/MSVC/%s" % (vc, version)
    if not rctx.path(root + "/lib").exists:
        fail("MSVC toolset %s is not installed under %s" % (version, vc))
    arch = rctx.attr.arch
    build = [
        'load("@rules_cc//cc:defs.bzl", "cc_library")',
        "",
        'package(default_visibility = ["//visibility:public"])',
        "",
    ]

    # Each component is optional on a machine; a target that needs a missing
    # one fails with the reason rather than at link time with LNK1104.
    spectre = "%s/lib/spectre/%s" % (root, arch)
    if rctx.path(spectre + "/msvcrt.lib").exists:
        rctx.symlink(spectre, "lib/spectre/" + arch)
        build += [
            "# link.exe searches /LIBPATH directories before the toolchain's LIB,",
            "# which is how MSBuild's SpectreMitigation property works too.",
            "cc_library(",
            '    name = "spectre_libs",',
            '    additional_linker_inputs = glob(["lib/spectre/%s/*.lib"]),' % arch,
            '    linkopts = ["/LIBPATH:external/%s/lib/spectre/%s"],' % (rctx.name, arch),
            ")",
            "",
        ]
    else:
        build += _missing("spectre_libs", "the Spectre-mitigated libraries of MSVC %s (%s); add " % (version, arch) +
                                          "'MSVC ... Spectre-mitigated libs' in the Visual Studio Installer")

    unittest = vc + "/Auxiliary/VS/UnitTest"
    if rctx.path(unittest + "/include/CppUnitTest.h").exists:
        rctx.symlink(unittest, "UnitTest")
        build += [
            "cc_library(",
            '    name = "cppunittest",',
            '    hdrs = glob(["UnitTest/include/*.h"]),',
            '    additional_linker_inputs = glob(["UnitTest/lib/%s/*.lib"]),' % arch,
            '    includes = ["UnitTest/include"],',
            "    # CppUnitTestCommon.h asks for \"<arch>\\\\...CppUnitTestFramework.lib\".",
            '    linkopts = ["/LIBPATH:external/%s/UnitTest/lib"],' % rctx.name,
            ")",
            "",
        ]
    else:
        build += _missing("cppunittest", "the C++ unit test framework of this Visual Studio instance")

    vstest = vc.rsplit("/", 1)[0] + "/Common7/IDE/Extensions/TestPlatform/vstest.console.exe"
    rctx.file("defs.bzl", "# Generated by msvc_toolset: paths inside the pinned Visual Studio instance.\n" +
                          "VSTEST_CONSOLE = %r\n" % (vstest if rctx.path(vstest).exists else ""))
    rctx.file("BUILD.bazel", "\n".join(build))

def _missing(name, what):
    return [
        "genrule(",
        '    name = "%s",' % name,
        '    outs = ["%s.missing"],' % name,
        '    cmd = "echo ERROR: not installed: %s && exit 1",' % what.replace('"', ""),
        ")",
        "",
    ]

msvc_toolset = repository_rule(
    implementation = _msvc_toolset_impl,
    attrs = {
        "vc": attr.string(doc = "The VC directory of the Visual Studio instance; defaults to BAZEL_VC."),
        "version": attr.string(doc = "Full toolset version, e.g. 14.51.36231; defaults to BAZEL_VC_FULL_VERSION."),
        "arch": attr.string(default = "x64", doc = "Target architecture directory name."),
    },
    environ = ["BAZEL_VC", "BAZEL_VC_FULL_VERSION"],
    local = True,
    doc = "Exposes optional parts of one installed Visual Studio instance and MSVC toolset.",
)
