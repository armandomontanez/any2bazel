"""winget's own post-processing of C#/WinRT sources (src/targets/EmbeddedCsWinRT.targets).

Projects that embed the CsWinRT runtime compile two sets of generated C#: the
projection cswinrt.exe writes, and the runtime sources the CsWinRT package
copies in from its `embedded/` directory (`any/` plus the framework's). winget's `WinGetWriteCsWinRTPragmaFiles`
target then writes a copy of EVERY one of those files, prefixed with

    // <auto-generated />
    #pragma warning disable

into `Generated Files/CsWinRTPragma/`, and compiles the copies instead of the
originals, so that the project's own warning policy does not apply to them.
It leaves out `Module.cs`, whose unversioned `SupportedOSPlatform` attribute
would make the platform analyzer (CA1416) reject every versioned WinRT call.

This is a project-specific build step, so it is a project-specific rule: the
any2bazel emitter cannot know it, and is told about it through its
`--generated-map` option.
"""

def _cswinrt_pragma_sources_impl(ctx):
    out = ctx.actions.declare_directory(ctx.label.name + ".cs")
    wanted = [f for f in ctx.files.package_files if f.extension == "cs" and
              any([("/" + p) in f.path for p in ctx.attr.package_prefixes])]
    inputs = ctx.files.srcs + wanted
    excluded = " ".join(ctx.attr.excludes)

    # The file list goes through a param file, not the command line: the shell
    # that runs this on Windows brace-expands its arguments, and one of the
    # embedded sources is named `EventHandlerEventSource{T}.cs`.
    files = ctx.actions.args()
    files.add_all(inputs, expand_directories = True)
    files.use_param_file("%s", use_always = True)
    files.set_param_file_format("multiline")

    # A BOM in the middle of a file is not whitespace to the C# lexer; the
    # MSBuild target reads each file as text, which drops it.
    ctx.actions.run_shell(
        command = """
set -eu
out="$1"
mkdir -p "$out"
while IFS= read -r f || [ -n "$f" ]; do
  f="${f%$'\\r'}"
  case "$f" in *.cs) ;; *) continue ;; esac
  case " $3 " in *" $(basename "$f") "*) continue ;; esac
  { printf '// <auto-generated />\\n#pragma warning disable\\n\\n'; sed '1s/^\\xEF\\xBB\\xBF//' "$f"; } > "$out/$(basename "$f")"
done < "$2"
""",
        arguments = [out.path, files, excluded],
        inputs = inputs,
        outputs = [out],
        mnemonic = "CsWinRTPragma",
        progress_message = "Prefixing C#/WinRT sources %{label}",
    )
    return [DefaultInfo(files = depset([out]))]

cswinrt_pragma_sources = rule(
    implementation = _cswinrt_pragma_sources_impl,
    attrs = {
        "srcs": attr.label_list(allow_files = True, doc = "The cswinrt projection (a directory of .cs files)."),
        "package_files": attr.label_list(allow_files = True, doc = "Files of the CsWinRT package the build names."),
        "package_prefixes": attr.string_list(
            default = ["embedded/any/", "embedded/net8.0/"],
            doc = "Which of the package's files are the embedded runtime for this target framework.",
        ),
        "excludes": attr.string_list(
            default = ["Module.cs"],
            doc = "File names the MSBuild target leaves out.",
        ),
    },
    doc = "Writes prefixed copies of generated C#/WinRT sources, as winget's MSBuild target does.",
)
